// ─── Points ──────────────────────────────────────────

enum PointTransactionType {
  EARN
  SPEND
}

enum PointSource {
  STUDY_TIME
  ATTENDANCE
  STREAK_BONUS
  BADGE_EARNED
  ITEM_PURCHASE
  DAILY_MISSION
  LEVEL_UP_BONUS
  ADMIN_GRANT
}

